# Email (Resend, from the Surf account). Unset = emails are saved to .data/outbox/*.json ("Saved to outbox (demo)").
RESEND_API_KEY=
RESEND_FROM=
# Path to the Claude Code CLI used for the LLM steps (no API key; uses the local subscription). Default: claude
CLAUDE_BIN=claude
# 1 = the UI replays fixtures (no server calls); 0 = real /api/check stream
NEXT_PUBLIC_MOCK=1
# Sponsor integrations (optional, off when unset)
SENSO_API_KEY=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
SENSO_BASE_URL=
# Plan A server options (all optional)
# BUYER_EMAIL: cc and reply-to on emails the buyer sends; SPECIALIST_EMAIL: where specialist requests go (default specialist@example.com)
BUYER_EMAIL=
SPECIALIST_EMAIL=
# 1 = serve recorded DataSF responses for the 6 demo addresses first (fast, offline-safe); network for everything else
HC_DEMO_RECORDINGS=0
# off = skip the Claude CLI (template sentences and regex parsing only)
HC_LLM=on
# per-request timeout for city data, ms (one jittered retry; stale cache beats a failure)
HC_FETCH_TIMEOUT_MS=10000
