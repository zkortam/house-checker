# Email (Resend, from the Surf account). Unset = emails are saved to .data/outbox/*.json ("Saved to outbox (demo)").
RESEND_API_KEY=
RESEND_FROM=
# Path to the Claude Code CLI used for the LLM steps (no API key; uses the local subscription). Default: claude
CLAUDE_BIN=claude
# 1 = the UI replays fixtures (no server calls); 0 = real /api/check stream
NEXT_PUBLIC_MOCK=1
# Sponsor integrations (optional, off when unset)
SENSO_API_KEY=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
